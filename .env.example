# PostgreSQL is intentionally pinned to 17.0 for backup migration compatibility.
POSTGRES_DB = "lycorisgal"
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
POSTGRES_PORT = "5432"
KUN_DATABASE_URL = "postgresql://postgres:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@localhost:5432/lycorisgal?schema=public"

KUN_VISUAL_NOVEL_SITE_URL = "https://www.lycorisgal.us"

NEXT_PUBLIC_KUN_PATCH_ADDRESS_DEV = "http://127.0.0.1:3000"
# Browser-visible API origin. Use the public site origin, never localhost or an image CDN.
NEXT_PUBLIC_KUN_PATCH_ADDRESS_PROD = "https://www.lycorisgal.us"

REDIS_HOST = '127.0.0.1'
REDIS_PORT = '6379'
# Set this if your Redis has `requirepass` (REQUIRED for any non-loopback deployment).
# REDIS_PASSWORD = ''

JWT_ISS = 'lycorisgal'
JWT_AUD = 'lycorisgal_admin'
# Generate a long random secret. Do NOT reuse this example value — it's public on GitHub.
#   openssl rand -base64 64
JWT_SECRET = 'REPLACE_ME_WITH_openssl_rand_-base64_64'
# 接入KunGal OAuth!
KUN_OAUTH_CLIENT_ID = ""
KUN_OAUTH_CLIENT_SECRET = ""
# 仅当你在本机自建了 OAuth 服务端时才改用 http://127.0.0.1:9277/api/v1
KUN_OAUTH_SERVER_URL = 'https://oauth.kungal.com/api/v1'
# 本地开发用 127.0.0.1:3000，生产换成线上域名。
KUN_OAUTH_REDIRECT_URI = 'http://127.0.0.1:3000/api/auth/oauth/kun/callback'

NODE_ENV = "development"
HOSTNAME = "127.0.0.1"

KUN_VISUAL_NOVEL_EMAIL_FROM = "LyCorisGAL"
KUN_VISUAL_NOVEL_EMAIL_HOST = "smtp.example.com"
KUN_VISUAL_NOVEL_EMAIL_PORT = '587'
KUN_VISUAL_NOVEL_EMAIL_ACCOUNT = "REPLACE_WITH_SMTP_ACCOUNT"
KUN_VISUAL_NOVEL_EMAIL_PASSWORD = "REPLACE_WITH_SMTP_PASSWORD"

KUN_VISUAL_NOVEL_S3_STORAGE_ACCESS_KEY_ID = "REPLACE_WITH_S3_ACCESS_KEY_ID"
KUN_VISUAL_NOVEL_S3_STORAGE_SECRET_ACCESS_KEY = "REPLACE_WITH_S3_SECRET_ACCESS_KEY"
KUN_VISUAL_NOVEL_S3_STORAGE_BUCKET_NAME = "REPLACE_WITH_S3_BUCKET"
KUN_VISUAL_NOVEL_S3_STORAGE_ENDPOINT = "https://s3.example.com"
KUN_VISUAL_NOVEL_S3_STORAGE_REGION = "REPLACE_WITH_S3_REGION"
NEXT_PUBLIC_KUN_VISUAL_NOVEL_S3_STORAGE_URL = "https://cdn.example.com"

KUN_VISUAL_NOVEL_IMAGE_BED_HOST = "images.example.com"
KUN_VISUAL_NOVEL_IMAGE_BED_URL = "https://images.example.com"

KUN_CF_CACHE_ZONE_ID = ""
KUN_CF_CACHE_PURGE_API_TOKEN = ""

KUN_VISUAL_NOVEL_INDEX_NOW_KEY = "REPLACE_WITH_INDEXNOW_KEY"

KUN_VISUAL_NOVEL_TEST_SITE_LABEL = "noindex"

KUN_DLSITE_API_URL = ""
TOUCHGAL_CF_CLEARANCE = ""
TOUCHGAL_TOKEN = ""

STEAM_API_KEY = ""
